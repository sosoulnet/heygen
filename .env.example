# Get your API key from https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=your_api_key_here

# Run: python heygen_video_creator.py --list-avatars  to find avatar IDs
HEYGEN_AVATAR_ID=your_avatar_id_here

# Run: python heygen_video_creator.py --list-voices  to find voice IDs
HEYGEN_VOICE_ID=your_voice_id_here
